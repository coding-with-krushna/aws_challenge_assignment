{
	"info": {
		"_postman_id": "49c34f21-9f6c-42d8-ae32-992825e6964d",
		"name": "VPC Management API",
		"description": "Collection to manage AWS VPCs and Subnets via API Gateway and Lambda",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "39940195"
	},
	"item": [
		{
			"name": "List All VPCs",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{id_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/v1/vpc",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"v1",
						"vpc"
					]
				},
				"description": "Fetches all VPC records from the DynamoDB registry."
			},
			"response": []
		},
		{
			"name": "Create New VPC",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{id_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"cidr_vpc\": \"10.0.0.0/16\",\n    \"subnets\": [\n        \"10.0.1.0/24\",\n        \"10.0.2.0/24\"\n    ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/v1/vpc",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"v1",
						"vpc"
					]
				},
				"description": "Triggers Lambda to create an AWS VPC and subnets, then records them in DynamoDB."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod",
			"type": "string"
		}
	]
}
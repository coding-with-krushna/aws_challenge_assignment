{
	"info": {
		"name": "VPC Management API",
		"description": "Collection to manage AWS VPCs and Subnets via API Gateway and Lambda",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "List All VPCs",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/v1/vpc",
					"host": ["{{baseUrl}}"],
					"path": ["v1", "vpc"]
				},
				"description": "Fetches all VPC records from the DynamoDB registry."
			}
		},
		{
			"name": "Create New VPC",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"cidr_vpc\": \"10.0.0.0/16\",\n    \"subnets\": [\n        \"10.0.1.0/24\",\n        \"10.0.2.0/24\"\n    ]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/v1/vpc",
					"host": ["{{baseUrl}}"],
					"path": ["v1", "vpc"]
				},
				"description": "Triggers Lambda to create an AWS VPC and subnets, then records them in DynamoDB."
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://e91olkomnh.execute-api.us-east-1.amazonaws.com/prod",
			"type": "string"
		}
	]
}